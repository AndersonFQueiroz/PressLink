# Supabase — valores públicos, seguros para uso no navegador
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Aplicação — URL pública canônica (OG, sitemap, links de exemplo).
# Em produção use o domínio real (ex.: https://presslink.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — e-mail de verificação (hook do Supabase; sem a chave o app segue
# funcionando com o SMTP padrão do Supabase).
RESEND_API_KEY=re_xxx
RESEND_FROM="PressLink <onboarding@resend.dev>"
SUPABASE_HOOK_SECRET=seu-hook-secret-aleatorio
